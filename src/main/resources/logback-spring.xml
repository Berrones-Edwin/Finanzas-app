<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Carpeta donde se guardarán los logs -->
    <property name="LOG_PATH" value="logs"/>

    <!-- Patrón de salida -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- Consola -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

    </appender>

    <!-- Archivo con rotación -->
    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <!-- Archivo actual -->
        <file>${LOG_PATH}/application.log</file>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

        <!-- Rotar por día y por tamaño -->
        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <!-- Nombre de archivos históricos -->
            <fileNamePattern>
                ${LOG_PATH}/application-%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <!-- Máximo tamaño por archivo -->
            <maxFileSize>10MB</maxFileSize>

            <!-- Conservar 30 días -->
            <maxHistory>30</maxHistory>

            <!-- Máximo espacio ocupado -->
            <totalSizeCap>1GB</totalSizeCap>

        </rollingPolicy>

    </appender>

    <!-- Tu aplicación -->
    <logger name="com.bitly" level="DEBUG"/>

    <!-- Framework -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>